{
  "name": "portfolio-frontend",
  "version": "1.0.0",
  "description": "Portfolio frontend with Next.js 14 and React",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-public-files.js",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "export": "next build && node scripts/copy-public-files.js && echo 'Static export ready in ./out'",
    "deploy-gh": "next build && node scripts/copy-public-files.js && gh-pages -d out -t",
    "deploy-gh-windows": "next build && node scripts/copy-public-files.js && node scripts/deploy-gh-pages.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.16",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.294.0",
    "next": "^14.0.0",
    "next-mdx-remote": "^4.4.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph": "^1.48.2",
    "react-hook-form": "^7.49.0",
    "tailwindcss": "^3.4.1",
    "three": "^0.183.2",
    "typescript": "^5.3.3",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.0",
    "gh-pages": "^6.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
